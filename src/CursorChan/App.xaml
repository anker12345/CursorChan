<Application x:Class="CursorChan.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Light"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <!-- 見出し用の丸ゴシック（M PLUS Rounded 1c / SIL Open Font License） -->
        <FontFamily x:Key="RoundFont">pack://application:,,,/Assets/Fonts/#M PLUS Rounded 1c</FontFamily>

        <!-- カーソルちゃんの色 -->
        <SolidColorBrush x:Key="Navy" Color="#262A5E" />
        <SolidColorBrush x:Key="Indigo" Color="#5A52C8" />
        <SolidColorBrush x:Key="Lavender" Color="#B9B2EC" />
        <SolidColorBrush x:Key="LavenderSoft" Color="#F3F1FF" />
        <SolidColorBrush x:Key="LavenderLine" Color="#DDD8FA" />
        <SolidColorBrush x:Key="Pink" Color="#F27BA2" />
        <SolidColorBrush x:Key="Star" Color="#F6C445" />
        <SolidColorBrush x:Key="SubText" Color="#6E6A9A" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardSelectedBg" Color="#F7F5FF" />

        <LinearGradientBrush x:Key="WindowBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#F2EEFF" />
            <GradientStop Offset="0.55" Color="#EDF0FF" />
            <GradientStop Offset="1" Color="#E6F5FF" />
        </LinearGradientBrush>

        <!-- Fluent テーマのアクセント色（適用ボタンやスライダー）をカーソルちゃんの紫に -->
        <Color x:Key="SystemAccentColor">#5A52C8</Color>
        <Color x:Key="SystemAccentColorLight1">#6B64D2</Color>
        <Color x:Key="SystemAccentColorLight2">#8C86E0</Color>
        <Color x:Key="SystemAccentColorLight3">#B9B2EC</Color>
        <Color x:Key="SystemAccentColorDark1">#4C45B3</Color>
        <Color x:Key="SystemAccentColorDark2">#3D3796</Color>
        <Color x:Key="SystemAccentColorDark3">#2E2A78</Color>
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#5A52C8" />
        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#6B64D2" />
        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#4C45B3" />
        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#4C45B3" />
        <!-- スライダー（Fluent のテンプレートが直接見ている色） -->
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#5A52C8" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#6B64D2" />
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#4C45B3" />
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#5A52C8" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#6B64D2" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#4C45B3" />

    </Application.Resources>
</Application>
