<Window x:Class="CursorChan.PngCursorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="画像からカーソルを作る" Width="520" Height="600" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,2,2" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#DDDDDD">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,1,1" />
                                <RectangleGeometry Rect="1,1,1,1" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="画像の中で「クリックが反応する点」（矢印なら先端）をクリックしてください。赤い十字の位置がそこになります。" />
        </StackPanel>

        <Border Grid.Row="1" Width="340" Height="340" Background="{StaticResource Checker}" CornerRadius="6"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"
                  MouseLeftButtonDown="Stage_MouseLeftButtonDown" Cursor="Cross" Background="Transparent">
                <Image x:Name="Preview" Stretch="Uniform" />
                <Canvas x:Name="Marker" IsHitTestVisible="False">
                    <Line x:Name="LineH" Stroke="Red" StrokeThickness="1.5" />
                    <Line x:Name="LineV" Stroke="Red" StrokeThickness="1.5" />
                    <Ellipse x:Name="Dot" Width="8" Height="8" Stroke="Red" StrokeThickness="1.5" />
                </Canvas>
            </Grid>
        </Border>

        <TextBlock x:Name="HotText" Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="作成" IsDefault="True" Padding="20,6" Margin="0,0,8,0" Click="Ok_Click"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="キャンセル" IsCancel="True" Padding="16,6" />
        </StackPanel>
    </Grid>
</Window>
