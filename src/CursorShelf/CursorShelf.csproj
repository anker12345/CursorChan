<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CursorShelf</AssemblyName>
    <RootNamespace>CursorShelf</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>CursorShelf</Product>
    <Description>マウスカーソルのギャラリー＆切り替えツール</Description>
    <Copyright>Copyright (c) 2026 anker12345</Copyright>
    <!-- WPF の Fluent テーマ（ThemeMode）は試験的機能扱いのため警告を抑える -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
